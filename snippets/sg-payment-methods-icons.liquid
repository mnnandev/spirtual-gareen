  {{ 'paypal' | payment_type_svg_tag: class: 'sg-payment-methods__icon' }}
</li>
<li class="sg-payment-methods__item" title="Visa" role="listitem">
  {% unless hide_labels %}<span class="visually-hidden">Visa</span>{% endunless %}
