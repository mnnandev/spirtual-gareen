{%- case icon -%}
  {%- when 'contact' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 6h16v12H4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'tags' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 12h4l2-7 4 14 2-7h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'hosting' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="4" width="18" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <rect x="3" y="14" width="18" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="7" cy="7" r="1" fill="currentColor"/>
      <circle cx="7" cy="17" r="1" fill="currentColor"/>
    </svg>
  {%- when 'social' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="8" cy="12" r="3" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="16" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="16" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'stats' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 19V9M10 19V5M15 19v-7M20 19v-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'optimize' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'external' -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="5" width="16" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 9h6M9 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg class="sg-legal-page__card-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
    </svg>
{%- endcase -%}
