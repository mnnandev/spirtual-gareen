{%- doc -%}
  Temporary PayPal button — links to checkout.
  Replace with official {{ form | payment_button }} when PayPal express is fully configured.

  @param {object} [form] - Unused for now (kept for call-site compatibility)
  @param {boolean} [show] - Whether to render (default true)
  @param {string} [class] - Extra class on the wrapper
  @param {string} [label] - Button label override
{%- enddoc -%}

{%- liquid
  assign sg_show = true
  if show == false
    assign sg_show = false
  endif
  assign sg_label = label | default: 'PayPal'
  assign sg_checkout_url = routes.cart_url | append: ''
  assign sg_checkout_url = '/checkout'
-%}

{%- if sg_show -%}
  <div
    class="sg-express-checkout sg-express-checkout--dummy{% if class != blank %} {{ class }}{% endif %}"
    data-sg-express-checkout
  >
    <a
      href="{{ sg_checkout_url }}"
      class="sg-paypal-dummy-btn"
      data-sg-paypal-dummy
    >
      <span class="sg-paypal-dummy-btn__mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 28" width="22" height="26" focusable="false">
          <path fill="#003087" d="M20.1 6.5c-.3-1.8-1.7-2.9-3.8-3.2H9.2c-.4 0-.8.3-.9.7L5.5 22.3c-.1.3.2.6.5.6h3.7l.9-5.6v.1c.1-.4.5-.7.9-.7h1.9c3.8 0 6.7-1.5 7.6-6 0-.1 0-.1.1-.2.3-1.1.2-2-.1-2.8v-.2z"/>
          <path fill="#009CDE" d="M20.1 6.5c-.3-1.8-1.7-2.9-3.8-3.2H9.2c-.4 0-.8.3-.9.7L5.5 22.3c-.1.3.2.6.5.6h3.7l1-6.1.1-.3c.1-.4.5-.7.9-.7h1.9c3.8 0 6.7-1.5 7.6-6 0-.1 0-.1.1-.2.2-1.1.1-2-.1-2.8-.1-.1-.1-.2-.1-.3z"/>
          <path fill="#012169" d="M9.4 8.8c0-.1.1-.2.2-.2h5.4c.6 0 1.1.1 1.5.2-.2-.9-.8-1.5-1.9-1.7H9.2c-.4 0-.8.3-.9.7L5.5 22.3c-.1.3.2.6.5.6h3.7l1-6.1 1.1-6.8.1-.2c.1-.4.5-.7.9-.7h.1c-.8 0-1.4.5-1.5 1.2z"/>
        </svg>
      </span>
      <span class="sg-paypal-dummy-btn__text">{{ sg_label }}</span>
    </a>
  </div>
{%- endif -%}
