{%- doc -%}
  Cart rewards progress: 3 milestones on one bar.
  €49 free shipping · €69 1st gift · €89 2nd gift
  Lives inside cart-summary so Horizon cart morphing updates with the cart total.
{%- enddoc -%}

{%- liquid
  assign milestone_1_cents = 4900
  assign milestone_2_cents = 6900
  assign milestone_3_cents = 8900
  assign max_cents = milestone_3_cents

  assign cart_total_cents = cart.items_subtotal_price | default: cart.total_price

  if max_cents > 0
    assign progress_pct = cart_total_cents | times: 100.0 | divided_by: max_cents
  else
    assign progress_pct = 100
  endif
  if progress_pct > 100
    assign progress_pct = 100
  endif
  if progress_pct < 0
    assign progress_pct = 0
  endif

  assign marker_1_pct = milestone_1_cents | times: 100.0 | divided_by: max_cents
  assign marker_2_pct = milestone_2_cents | times: 100.0 | divided_by: max_cents
  assign marker_3_pct = 100

  assign m1_done = false
  assign m2_done = false
  assign m3_done = false
  if cart_total_cents >= milestone_1_cents
    assign m1_done = true
  endif
  if cart_total_cents >= milestone_2_cents
    assign m2_done = true
  endif
  if cart_total_cents >= milestone_3_cents
    assign m3_done = true
  endif

  if m3_done
    assign status_key = 'all'
  elsif m2_done == false and m1_done
    assign status_key = 'gift1'
    assign remaining_cents = milestone_2_cents | minus: cart_total_cents
  elsif m1_done == false
    assign status_key = 'shipping'
    assign remaining_cents = milestone_1_cents | minus: cart_total_cents
  else
    assign status_key = 'gift2'
    assign remaining_cents = milestone_3_cents | minus: cart_total_cents
  endif

  if remaining_cents < 0
    assign remaining_cents = 0
  endif
  assign remaining_money = remaining_cents | money
-%}

{%- unless cart.empty? -%}
  <div
    class="sg-cart-incentives{% if m3_done %} is-complete{% endif %}"
    data-sg-cart-incentives
    data-cart-total="{{ cart_total_cents }}"
    data-max="{{ max_cents }}"
    aria-live="polite"
  >
    <p class="sg-cart-incentives__text">
      {%- case status_key -%}
        {%- when 'shipping' -%}
          {{ 'spiritual_green.cart_free_shipping_remaining' | t: amount: remaining_money }}
        {%- when 'gift1' -%}
          {{ 'spiritual_green.cart_gift_remaining' | t: amount: remaining_money }}
        {%- when 'gift2' -%}
          {{ 'spiritual_green.cart_gift_remaining' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'spiritual_green.cart_rewards_complete' | t }}
      {%- endcase -%}
    </p>

    <div
      class="sg-cart-incentives__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress_pct | round }}"
      aria-label="Progresso verso spedizione gratuita e regali"
    >
      <div class="sg-cart-incentives__progress">
        <span
          class="sg-cart-incentives__progress-fill"
          style="width: {{ progress_pct }}%;"
        ></span>
      </div>

      <ul class="sg-cart-incentives__milestones" role="list">
        <li
          class="sg-cart-incentives__milestone{% if m1_done %} is-achieved{% endif %}"
          style="left: {{ marker_1_pct }}%;"
        >
          <span class="sg-cart-incentives__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 8h13v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z"/>
              <path d="M16 11h3.5a1.5 1.5 0 0 1 1.5 1.5V16a2 2 0 0 1-2 2H16"/>
              <path d="M6 8V6.5A1.5 1.5 0 0 1 7.5 5h0A1.5 1.5 0 0 1 9 6.5V8"/>
              <circle cx="7.5" cy="17.5" r="1.4"/>
              <circle cx="15.5" cy="17.5" r="1.4"/>
            </svg>
          </span>
          <span class="sg-cart-incentives__dot" aria-hidden="true"></span>
          <span class="sg-cart-incentives__amount">49€</span>
        </li>

        <li
          class="sg-cart-incentives__milestone{% if m2_done %} is-achieved{% endif %}"
          style="left: {{ marker_2_pct }}%;"
        >
          <span class="sg-cart-incentives__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="10" width="18" height="11" rx="1.5"/>
              <path d="M12 10V21"/>
              <path d="M3 14h18"/>
              <path d="M12 10c-1.8-2.8-4.8-3.2-6-1.6S6.5 12 8 12c1.2 0 2.5-.7 4-2z"/>
              <path d="M12 10c1.8-2.8 4.8-3.2 6-1.6S17.5 12 16 12c-1.2 0-2.5-.7-4-2z"/>
            </svg>
          </span>
          <span class="sg-cart-incentives__dot" aria-hidden="true"></span>
          <span class="sg-cart-incentives__amount">69€</span>
        </li>

        <li
          class="sg-cart-incentives__milestone{% if m3_done %} is-achieved{% endif %}"
          style="left: {{ marker_3_pct }}%;"
        >
          <span class="sg-cart-incentives__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="10" width="18" height="11" rx="1.5"/>
              <path d="M12 10V21"/>
              <path d="M3 14h18"/>
              <path d="M12 10c-1.8-2.8-4.8-3.2-6-1.6S6.5 12 8 12c1.2 0 2.5-.7 4-2z"/>
              <path d="M12 10c1.8-2.8 4.8-3.2 6-1.6S17.5 12 16 12c-1.2 0-2.5-.7-4-2z"/>
            </svg>
          </span>
          <span class="sg-cart-incentives__dot" aria-hidden="true"></span>
          <span class="sg-cart-incentives__amount">89€</span>
        </li>
      </ul>
    </div>
  </div>
{%- endunless -%}
