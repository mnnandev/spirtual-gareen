
{% liquid
  assign rating = section.settings.rating
  assign review_count = section.settings.review_count
  assign count_5 = section.settings.count_5
  assign count_4 = section.settings.count_4
  assign count_3 = section.settings.count_3
  assign count_2 = section.settings.count_2
  assign count_1 = section.settings.count_1

  if product != blank
    if product.metafields.reviews.rating.value.rating != blank
      assign rating = product.metafields.reviews.rating.value.rating
    endif
    if product.metafields.reviews.rating_count != blank
      assign review_count = product.metafields.reviews.rating_count
    endif
  endif

  assign total_breakdown = count_5 | plus: count_4 | plus: count_3 | plus: count_2 | plus: count_1
  if total_breakdown == 0
    assign total_breakdown = review_count
  endif

  assign bar_5 = 0
  assign bar_4 = 0
  assign bar_3 = 0
  assign bar_2 = 0
  assign bar_1 = 0
  if total_breakdown > 0
    assign bar_5 = count_5 | times: 100 | divided_by: total_breakdown
    assign bar_4 = count_4 | times: 100 | divided_by: total_breakdown
    assign bar_3 = count_3 | times: 100 | divided_by: total_breakdown
    assign bar_2 = count_2 | times: 100 | divided_by: total_breakdown
    assign bar_1 = count_1 | times: 100 | divided_by: total_breakdown
  endif

  assign rating_rounded = rating | round: 1
  assign full_stars = rating | floor
  assign decimal = rating | modulo: 1
  assign show_half = false
  if decimal >= 0.3 and decimal <= 0.7
    assign show_half = true
  elsif decimal > 0.7
    assign full_stars = full_stars | plus: 1
  endif
  assign half_star_index = full_stars | plus: 1
  assign based_on_label = section.settings.based_on_text | replace: '[count]', review_count
%}

<section
  id="recensioni"
  class="sg-product-reviews custom-product-reviews-section"
  data-section-id="{{ section.id }}"
  style="--sg-reviews-pt: {{ section.settings.padding_top }}px; --sg-reviews-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="sg-product-reviews__container page-width">
    <div class="sg-product-reviews__inner">
      <div class="sg-product-reviews__summary">
        <p class="sg-product-reviews__score">{{ rating_rounded }}</p>
        <div class="sg-product-reviews__stars" aria-label="{{ rating_rounded }} su 5">
          {%- for i in (1..5) -%}
            <svg class="sg-product-reviews__star" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
              {% if show_half and i == half_star_index %}
                <defs>
                  <linearGradient id="sg-star-half-{{ section.id }}-{{ i }}">
                    <stop offset="50%" stop-color="currentColor"></stop>
                    <stop offset="50%" stop-color="#e8e4dc"></stop>
                  </linearGradient>
                </defs>
                <path fill="url(#sg-star-half-{{ section.id }}-{{ i }})" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
              {% elsif i <= full_stars %}
                <path fill="currentColor" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
              {% else %}
                <path fill="#e8e4dc" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.2l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z"/>
              {% endif %}
            </svg>
          {%- endfor -%}
        </div>
        <p class="sg-product-reviews__based">{{ based_on_label }}</p>
      </div>

      <div class="sg-product-reviews__divider" aria-hidden="true"></div>

      <div class="sg-product-reviews__breakdown">
        <h2 class="sg-product-reviews__heading">{{ section.settings.heading }}</h2>

        <ul class="sg-product-reviews__bars" role="list">
          <li class="sg-product-reviews__bar-row">
            <span class="sg-product-reviews__bar-label">5 {% render 'sg-review-star-icon' %}</span>
            <span class="sg-product-reviews__bar-track"><span class="sg-product-reviews__bar-fill" style="width: {{ bar_5 }}%;"></span></span>
            <span class="sg-product-reviews__bar-count">{{ count_5 }}</span>
          </li>
          <li class="sg-product-reviews__bar-row">
            <span class="sg-product-reviews__bar-label">4 {% render 'sg-review-star-icon' %}</span>
            <span class="sg-product-reviews__bar-track"><span class="sg-product-reviews__bar-fill" style="width: {{ bar_4 }}%;"></span></span>
            <span class="sg-product-reviews__bar-count">{{ count_4 }}</span>
          </li>
          <li class="sg-product-reviews__bar-row">
            <span class="sg-product-reviews__bar-label">3 {% render 'sg-review-star-icon' %}</span>
            <span class="sg-product-reviews__bar-track"><span class="sg-product-reviews__bar-fill" style="width: {{ bar_3 }}%;"></span></span>
            <span class="sg-product-reviews__bar-count">{{ count_3 }}</span>
          </li>
          <li class="sg-product-reviews__bar-row">
            <span class="sg-product-reviews__bar-label">2 {% render 'sg-review-star-icon' %}</span>
            <span class="sg-product-reviews__bar-track"><span class="sg-product-reviews__bar-fill" style="width: {{ bar_2 }}%;"></span></span>
            <span class="sg-product-reviews__bar-count">{{ count_2 }}</span>
          </li>
          <li class="sg-product-reviews__bar-row">
            <span class="sg-product-reviews__bar-label">1 {% render 'sg-review-star-icon' %}</span>
            <span class="sg-product-reviews__bar-track"><span class="sg-product-reviews__bar-fill" style="width: {{ bar_1 }}%;"></span></span>
            <span class="sg-product-reviews__bar-count">{{ count_1 }}</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recensioni riepilogo",
  "tag": "section",
  "class": "custom-product-reviews-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recensioni clienti"
    },
    {
      "type": "text",
      "id": "based_on_text",
      "label": "Summary text",
      "default": "Basato su [count] recensioni",
      "info": "Use [count] for review total."
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Average rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Total review count",
      "default": 13247
    },
    {
      "type": "number",
      "id": "count_5",
      "label": "5 star reviews",
      "default": 11675
    },
    {
      "type": "number",
      "id": "count_4",
      "label": "4 star reviews",
      "default": 1065
    },
    {
      "type": "number",
      "id": "count_3",
      "label": "3 star reviews",
      "default": 304
    },
    {
      "type": "number",
      "id": "count_2",
      "label": "2 star reviews",
      "default": 95
    },
    {
      "type": "number",
      "id": "count_1",
      "label": "1 star reviews",
      "default": 108
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Recensioni riepilogo"
    }
  ]
}
{% endschema %}
