{% liquid
  assign heading = section.settings.heading | default: 'Iscriviti alla Nostra Newsletter Settimanale'
  assign description = section.settings.description | default: 'Ricevi offerte esclusive, consigli sul benessere naturale e novità dal mondo Spiritual Green — direttamente nella tua casella di posta.'
  assign button_label = section.settings.button_label | default: 'Iscriviti'
  assign email_placeholder = section.settings.email_placeholder | default: 'La tua email'
%}

<section
  id="SgNewsletterCta-{{ section.id }}"
  class="sg-newsletter-cta"
  data-section-id="{{ section.id }}"
>
  <div class="sg-newsletter-cta__wrap">
    <div class="sg-newsletter-cta__card">
      <div class="sg-newsletter-cta__content">
        <div class="sg-newsletter-cta__copy">
          {% if heading != blank %}
            <h2 class="sg-newsletter-cta__heading">{{ heading }}</h2>
          {% endif %}
          {% if description != blank %}
            <p class="sg-newsletter-cta__text">{{ description }}</p>
          {% endif %}
        </div>

        <div class="sg-newsletter-cta__form-col">
          {% form 'customer', id: 'SgNewsletterCtaForm', class: 'sg-newsletter-cta__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter,cta-banner">
            <div class="sg-newsletter-cta__form-box">
              <label class="visually-hidden" for="SgNewsletterCta-email-{{ section.id }}">{{ email_placeholder }}</label>
              <input
                id="SgNewsletterCta-email-{{ section.id }}"
                class="sg-newsletter-cta__input"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ email_placeholder }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                required
              >
              <button class="sg-newsletter-cta__submit" type="submit" name="commit">
                <span>{{ button_label }}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"/>
                  <path d="M7 7h10v10"/>
                </svg>
              </button>
            </div>
            {% if form.posted_successfully? %}
              <p class="sg-newsletter-cta__message sg-newsletter-cta__message--success">
                Grazie! Controlla la tua email.
              </p>
            {% endif %}
            {% if form.errors %}
              <p class="sg-newsletter-cta__message sg-newsletter-cta__message--error">
                {{ form.errors.messages.email | first | default: form.errors | default_errors }}
              </p>
            {% endif %}
          {% endform %}
        </div>
      </div>

      <button
        type="button"
        class="sg-newsletter-cta__back-top"
        data-back-to-top
        aria-label="Torna su"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m18 15-6-6-6 6"/>
        </svg>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  .sg-newsletter-cta {
    background: #ffffff;
    padding: clamp(40px, 5vw, 56px) 0 clamp(56px, 6.5vw, 72px);
    box-sizing: border-box;
  }

  .sg-newsletter-cta__wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .sg-newsletter-cta__card {
    position: relative;
    border-radius: 20px;
    padding: clamp(36px, 4.5vw, 52px) clamp(32px, 4vw, 56px) clamp(48px, 5vw, 60px);
    background: #1a221a;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.14);
    overflow: visible;
    box-sizing: border-box;
  }

  .sg-newsletter-cta__content {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 4.5vw, 56px);
  }

  .sg-newsletter-cta__heading {
    margin: 0 0 16px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(1.45rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .sg-newsletter-cta__text {
    margin: 0;
    max-width: 54ch;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: clamp(14px, 1.2vw, 15px);
    font-weight: 400;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
  }

  .sg-newsletter-cta__form {
    margin: 0;
    width: 100%;
  }

  .sg-newsletter-cta__form-box {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.03);
    box-sizing: border-box;
  }

  .sg-newsletter-cta__input {
    width: 100%;
    min-height: 50px;
    padding: 14px 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.2;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .sg-newsletter-cta__input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .sg-newsletter-cta__input:focus {
    border-color: rgba(151, 196, 138, 0.55);
    background: rgba(255, 255, 255, 0.08);
  }

  .sg-newsletter-cta__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 50px;
    padding: 14px 24px;
    border: none;
    border-radius: 999px;
    background: linear-gradient(90deg, #B0D4A6 0%, #97C48A 50%, #7FAF72 100%);
    color: #ffffff;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: filter 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    box-sizing: border-box;
    box-shadow: 0 6px 20px rgba(151, 196, 138, 0.28);
  }

  .sg-newsletter-cta__submit:hover {
    filter: brightness(1.06);
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(151, 196, 138, 0.34);
  }

  .sg-newsletter-cta__message {
    margin: 12px 0 0;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 13px;
    line-height: 1.4;
  }

  .sg-newsletter-cta__message--success {
    color: #a8e878;
  }

  .sg-newsletter-cta__message--error {
    color: #ffb4b4;
  }

  .sg-newsletter-cta__back-top {
    position: absolute;
    left: 50%;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: linear-gradient(145deg, #B0D4A6 0%, #97C48A 55%, #7FAF72 100%);
    color: #ffffff;
    cursor: pointer;
    transform: translate(-50%, 50%);
    box-shadow: 0 8px 22px rgba(151, 196, 138, 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .sg-newsletter-cta__back-top:hover {
    transform: translate(-50%, 50%) translateY(-3px);
    box-shadow: 0 12px 28px rgba(151, 196, 138, 0.42);
  }

  @media screen and (max-width: 900px) {
    .sg-newsletter-cta__content {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .sg-newsletter-cta__text {
      max-width: none;
    }
  }

  @media screen and (max-width: 560px) {
    .sg-newsletter-cta__card {
      padding: 28px 20px 48px;
      border-radius: 16px;
    }

    .sg-newsletter-cta__form-box {
      padding: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initSgNewsletterCta(root = document) {
    const buttons = root.querySelectorAll('[data-back-to-top]');
    buttons.forEach((btn) => {
      if (btn.dataset.backTopReady === 'true') return;
      btn.dataset.backTopReady = 'true';
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });
  }

  initSgNewsletterCta();

  document.addEventListener('shopify:section:load', (event) => {
    if (event.target instanceof HTMLElement) {
      initSgNewsletterCta(event.target);
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Newsletter CTA banner",
  "tag": "section",
  "class": "sg-newsletter-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Iscriviti alla Nostra Newsletter Settimanale"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Ricevi offerte esclusive, consigli sul benessere naturale e novità dal mondo Spiritual Green — direttamente nella tua inbox."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "La tua email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Iscriviti"
    }
  ],
  "presets": [
    {
      "name": "Newsletter CTA banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
