{% liquid
  assign hero_title = section.settings.title | default: 'Consulenza Online con Alice'
  assign hero_subtitle = section.settings.subtitle
  assign hero_eyebrow = section.settings.eyebrow | default: 'Spiritual Green'
  assign cta_label = section.settings.cta_label | default: 'Prenota la tua consulenza'
  assign cta_action = section.settings.cta_action | default: 'scroll'
  assign hero_image = section.settings.image
  assign hero_image_url = section.settings.image_url
  assign hero_image_alt = section.settings.image_alt | default: 'Consulenza online con Alice illustrazione'
%}

<section
  class="consulenza-hero"
  id="consulenza-hero-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="consulenza-hero__inner">
    <div class="consulenza-hero__content">
      {% if hero_eyebrow != blank %}
        <p class="consulenza-hero__eyebrow">{{ hero_eyebrow }}</p>
      {% endif %}
      <h1 class="consulenza-hero__title">{{ hero_title }}</h1>
      {% if hero_subtitle != blank %}
        <p class="consulenza-hero__subtitle">{{ hero_subtitle }}</p>
      {% endif %}
      <button
        type="button"
        class="consulenza-hero__cta btn-prenota-ora"
        data-sg-consulenza-booking="{{ cta_action }}"
      >
        {{ cta_label }}
      </button>
    </div>

    <div class="consulenza-hero__media" aria-hidden="true">
      {% if hero_image != blank %}
        {{
          hero_image
          | image_url: width: 1200
          | image_tag:
            class: 'consulenza-hero__image',
            loading: 'eager',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 42vw, 100vw',
            alt: hero_image_alt
        }}
      {% elsif hero_image_url != blank %}
        <img
          class="consulenza-hero__image"
          src="{{ hero_image_url }}"
          alt="{{ hero_image_alt | escape }}"
          width="500"
          height="500"
          loading="eager"
        >
      {% else %}
        <div class="consulenza-hero__image consulenza-hero__image--placeholder">
          {{ 'sg-consulenza-hero-image.svg' | inline_asset_content }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<script src="{{ 'sg-consulenza-booking.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Consulenza Hero",
  "tag": "section",
  "class": "consulenza-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Spiritual Green"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Consulenza Online con Alice"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Scopri come possiamo aiutarti a trovare il tuo benessere naturale con una consulenza personalizzata."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Prenota la tua consulenza"
    },
    {
      "type": "select",
      "id": "cta_action",
      "label": "CTA action",
      "default": "scroll",
      "options": [
        { "value": "scroll", "label": "Scroll to booking" },
        { "value": "popup", "label": "Open Calendly popup" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Hero image URL override",
      "info": "Used when no image is selected.",
      "default": "https://cdn.shopify.com/s/files/1/0998/9482/1248/files/6867548.jpg?v=1781691490"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image alt text",
      "default": "Consulenza online con Alice illustrazione"
    }
  ]
}
{% endschema %}
