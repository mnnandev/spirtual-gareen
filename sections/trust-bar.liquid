<section
  class="trust-bar"
  id="trust-bar-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="trust-bar__container">
    <div class="trust-bar__item sg-animate" data-delay="1">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a9 9 0 0 1 9 9c0 4.97-9 13-9 13S3 15.97 3 11a9 9 0 0 1 9-9z"/>
          <circle cx="12" cy="11" r="3"/>
        </svg>
      </div>
      <div class="trust-bar__content">
        <span class="trust-bar__highlight">{{ section.settings.stat_1_number }}</span>
        <span class="trust-bar__label">{{ section.settings.stat_1_text }}</span>
      </div>
    </div>

    <div class="trust-bar__divider" aria-hidden="true"></div>

    <div class="trust-bar__item sg-animate" data-delay="2">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/>
          <line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
      </div>
      <div class="trust-bar__content">
        <span class="trust-bar__highlight">{{ section.settings.stat_2_number }}</span>
        <span class="trust-bar__label">{{ section.settings.stat_2_text }}</span>
      </div>
    </div>

    <div class="trust-bar__divider" aria-hidden="true"></div>

    <div class="trust-bar__item sg-animate" data-delay="3">
      <div class="trust-bar__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <div class="trust-bar__content">
        <span class="trust-bar__highlight">{{ section.settings.stat_3_number }}</span>
        <span class="trust-bar__label">{{ section.settings.stat_3_text }}</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-bar {
    background: #ffffff;
    border-top: 1px solid #D8E8D4;
    border-bottom: 1px solid #D8E8D4;
    padding: 48px 0;
    box-sizing: border-box;
  }

  .trust-bar__container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    box-sizing: border-box;
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    justify-content: center;
    padding: 0 32px;
    box-sizing: border-box;
  }

  .trust-bar__icon {
    width: 52px;
    height: 52px;
    background: #EFF5ED;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #B0D4A6;
  }

  .trust-bar__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .trust-bar__highlight {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.375rem, 2.5vw, 1.625rem);
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .trust-bar__label {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 14px;
    color: #666666;
    line-height: 1.5;
    margin-top: 4px;
    max-width: 160px;
  }

  .trust-bar__divider {
    width: 1px;
    height: 64px;
    background: #D8E8D4;
    flex-shrink: 0;
  }

  .trust-bar .sg-animate {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .trust-bar .sg-animate.sg-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .trust-bar .sg-animate[data-delay='1'] { transition-delay: 0.05s; }
  .trust-bar .sg-animate[data-delay='2'] { transition-delay: 0.1s; }
  .trust-bar .sg-animate[data-delay='3'] { transition-delay: 0.15s; }

  @media screen and (max-width: 768px) {
    .trust-bar {
      padding: 40px 0;
    }

    .trust-bar__container {
      flex-direction: column;
      gap: 32px;
    }

    .trust-bar__divider {
      width: 64px;
      height: 1px;
    }

    .trust-bar__item {
      padding: 0;
      justify-content: flex-start;
      width: 100%;
      max-width: 280px;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initTrustBarAnimate(root = document) {
    const items = root.querySelectorAll('.trust-bar .sg-animate');
    if (!items.length) return;

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('sg-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('sg-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -30px 0px' }
    );

    items.forEach((item) => {
      if (!item.classList.contains('sg-visible')) {
        observer.observe(item);
      }
    });
  }

  initTrustBarAnimate();

  document.addEventListener('shopify:section:load', (event) => {
    if (event.target instanceof HTMLElement) {
      initTrustBarAnimate(event.target);
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "trust-bar-section",
  "settings": [
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 — Number/Date",
      "default": "Dal 1987"
    },
    {
      "type": "text",
      "id": "stat_1_text",
      "label": "Stat 1 — Label",
      "default": "La tua erboristeria di fiducia"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 — Number",
      "default": "35+ Anni"
    },
    {
      "type": "text",
      "id": "stat_2_text",
      "label": "Stat 2 — Label",
      "default": "Di esperienza nel benessere naturale"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 — Number",
      "default": "Migliaia"
    },
    {
      "type": "text",
      "id": "stat_3_text",
      "label": "Stat 3 — Label",
      "default": "Di clienti soddisfatti ogni anno"
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "category": "Custom"
    }
  ]
}
{% endschema %}
