{% liquid
  assign show_announcement = section.settings.show_announcement
  assign whatsapp_phone_display = section.settings.whatsapp_phone | default: '+39 3939999136' | strip
  assign whatsapp_digits = whatsapp_phone_display | replace: '+', '' | replace: ' ', '' | replace: '-', ''
  assign whatsapp_url = 'https://wa.me/' | append: whatsapp_digits
  assign line_assistenza_label = 'Assistenza'
  assign line_consegna = 'Consegna rapida e sicura'
  assign line_spedizione = 'Spedizione gratuita sopra i 49€'
  assign marquee_speed = section.settings.marquee_speed | default: 45
  assign wa_icon = 'sg-whatsapp-icon.svg' | asset_url
%}

{% if show_announcement %}
  <div
    class="announcement-bar sg-announcement-marquee sg-topbar"
    role="region"
    aria-label="{{ 'spiritual_green.announcement' | t }}"
    style="--sg-marquee-duration: {{ marquee_speed }}s;"
    data-sg-marquee-speed-px="20"
  >
    {%- comment -%} Desktop: Zanetti-style 3 equal columns + 1px white dividers {%- endcomment -%}
    <div class="sg-topbar__inner">
      <div class="sg-topbar__col sg-topbar__col--left">
        <div class="sg-topbar__item">
          <div class="sg-topbar__label">
            <a
              class="sg-topbar__assistenza"
              href="{{ whatsapp_url }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{{ line_assistenza_label }}</span>
              <img
                class="sg-topbar__wa-icon"
                src="{{ wa_icon }}"
                alt="WhatsApp"
                width="14"
                height="14"
                loading="eager"
                decoding="async"
              >
              <span>{{ whatsapp_phone_display }}</span>
            </a>
          </div>
        </div>
      </div>
      <div class="sg-topbar__col sg-topbar__col--center">
        <div class="sg-topbar__item">
          <div class="sg-topbar__label">{{ line_consegna }}</div>
        </div>
      </div>
      <div class="sg-topbar__col sg-topbar__col--right">
        <div class="sg-topbar__item">
          <div class="sg-topbar__label">{{ line_spedizione }}</div>
        </div>
      </div>
    </div>

    {%- comment -%} Mobile: scrolling marquee with the same 3 lines {%- endcomment -%}
    <div class="announcement-bar__marquee-wrapper">
      <div class="announcement-bar__marquee-track">
        {% for i in (1..2) %}
          <span class="announcement-bar__marquee-content"{% if i == 2 %} aria-hidden="true"{% endif %}>
            <span class="sg-topbar__seg">
              <a class="sg-topbar__assistenza" href="{{ whatsapp_url }}" target="_blank" rel="noopener noreferrer">
                <span>{{ line_assistenza_label }}</span>
                <img class="sg-topbar__wa-icon" src="{{ wa_icon }}" alt="" width="14" height="14" loading="eager" decoding="async">
                <span>{{ whatsapp_phone_display }}</span>
              </a>
            </span>
            <span class="announcement-bar__separator" aria-hidden="true">·</span>
            <span class="sg-topbar__seg">{{ line_consegna }}</span>
            <span class="announcement-bar__separator" aria-hidden="true">·</span>
            <span class="sg-topbar__seg">{{ line_spedizione }}</span>
            <span class="announcement-bar__separator" aria-hidden="true">·</span>
          </span>
        {% endfor %}
      </div>
    </div>
  </div>

  <script src="{{ 'sg-announcement-marquee.js' | asset_url }}" defer></script>
{% endif %}

{% stylesheet %}
  /* Match pietrozanettihome.com .topbar (desktop reference) */
  .sg-topbar.announcement-bar {
    background-color: #B1C1A7;
    color: #ffffff;
    width: 100%;
    overflow: hidden;
    padding: 7px 0;
    position: relative;
    z-index: 100;
    border: none;
  }

  .sg-topbar__inner {
    display: none;
  }

  .sg-topbar .announcement-bar__marquee-wrapper {
    overflow: hidden;
    white-space: nowrap;
    width: 100%;
  }

  .sg-topbar .announcement-bar__marquee-track {
    display: inline-flex;
    animation: sg-marquee-scroll max(40s, var(--sg-marquee-duration, 45s)) linear infinite;
    white-space: nowrap;
    will-change: transform;
  }

  .sg-topbar .announcement-bar__marquee-content {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding-right: 24px;
    font-family: var(--sg-font-body, 'Config', system-ui, sans-serif);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: #ffffff;
    line-height: 1.3;
  }

  .sg-topbar .sg-topbar__seg {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .sg-topbar .announcement-bar__separator {
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    flex-shrink: 0;
    line-height: 1;
  }

  .sg-topbar__assistenza {
    display: inline-flex;
    align-items: center;
    color: #ffffff !important;
    text-decoration: none !important;
    gap: 0;
    line-height: 1.3;
  }

  .sg-topbar__assistenza:hover {
    color: #ffffff !important;
    opacity: 1;
    text-decoration: none !important;
  }

  .sg-topbar__wa-icon {
    display: inline-block;
    width: 14px !important;
    height: 14px !important;
    margin: 0 5px !important;
    flex-shrink: 0;
    vertical-align: middle;
    object-fit: contain;
  }

  @keyframes sg-marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .sg-topbar:hover .announcement-bar__marquee-track {
    animation-play-state: paused;
  }

  /* Desktop ≥960px — Zanetti static 3-column topbar */
  @media screen and (min-width: 960px) {
    .sg-topbar .announcement-bar__marquee-wrapper {
      display: none !important;
    }

    .sg-topbar__inner {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      align-items: center;
      width: 100%;
      max-width: 100%;
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .sg-topbar__col {
      display: flex;
      align-items: center;
      justify-content: center;
      min-width: 0;
      text-align: center;
      position: relative;
      border-right: 1px solid #ffffff;
      padding: 0 16px;
      box-sizing: border-box;
    }

    .sg-topbar__col:last-child {
      border-right: 0;
    }

    .sg-topbar__item {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      font-family: var(--sg-font-body, 'Config', system-ui, sans-serif);
      font-size: 14px; /* Zanetti 1.4rem @ 10px root */
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
      line-height: 1.3;
      color: #ffffff;
      white-space: nowrap;
    }

    .sg-topbar__label {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      line-height: 1.3;
      color: #ffffff;
      width: 100%;
    }

    .sg-topbar__col--left .sg-topbar__label {
      justify-content: center;
    }

    .sg-topbar__assistenza {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media screen and (max-width: 959px) {
    .sg-topbar__inner {
      display: none !important;
    }

    .sg-topbar.announcement-bar {
      padding: 4px 0;
    }

    .sg-topbar .announcement-bar__marquee-content {
      font-size: 11px;
      line-height: 1.25;
      gap: 20px;
      padding-right: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sg-topbar .announcement-bar__marquee-track {
      animation: none;
      transform: none;
      justify-content: center;
      width: 100%;
    }

    .sg-topbar .announcement-bar__marquee-content[aria-hidden='true'] {
      display: none;
    }

    .sg-topbar .announcement-bar__marquee-content {
      padding-right: 0;
      justify-content: center;
      width: 100%;
      white-space: normal;
      flex-wrap: wrap;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "WhatsApp phone (Assistenza)",
      "default": "+39 3939999136",
      "info": "Shown after the WhatsApp icon. Digits are used for the wa.me link."
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee scroll duration",
      "info": "Mobile only. Higher = slower.",
      "min": 30,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar"
    }
  ]
}
{% endschema %}
