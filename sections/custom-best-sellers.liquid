{% liquid
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign shop_all_link = section.settings.shop_all_link
  assign max_products = section.settings.max_products | default: 8

  if section.settings.collection != blank
    assign products_collection = section.settings.collection
  else
    assign products_collection = collections.all
  endif
%}

<section
  id="CustomBestSellers-{{ section.id }}"
  class="custom-best-sellers{% if section.settings.background_style == 'alt' %} custom-best-sellers--alt{% endif %}"
  data-section-id="{{ section.id }}"
>
  <div class="custom-best-sellers__inner">
    <header class="custom-best-sellers__header">
      <div class="custom-best-sellers__header-row">
        {% if heading != blank %}
          <h2 class="custom-best-sellers__heading">{{ heading }}</h2>
        {% endif %}

        <a
          class="custom-best-sellers__shop-all"
          {% if shop_all_link != blank %}
            href="{{ shop_all_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
        >
          {{ 'spiritual_green.shop_all' | t }} →
        </a>
      </div>

      {% if description != blank %}
        <p class="custom-best-sellers__description">{{ description }}</p>
      {% endif %}
    </header>

    {% if products_collection != blank and products_collection.products_count > 0 %}
      <ul class="custom-best-sellers__grid" role="list">
        {% for product in products_collection.products limit: max_products %}
          {% liquid
            assign variant = product.selected_or_first_available_variant
            assign show_badge = false
            if section.settings.featured_badge != blank and forloop.first
              assign show_badge = true
            endif

            capture card_title
              render 'sg-product-card-fields', product: product, output: 'title'
            endcapture
            assign card_title = card_title | strip

            capture card_format
              render 'sg-product-card-fields', product: product, output: 'format'
            endcapture
            assign card_format = card_format | strip

            capture card_description
              render 'sg-product-card-fields', product: product, output: 'description', limit: 120
            endcapture
            assign card_description = card_description | strip
          %}
          <li
            class="custom-best-sellers__item sg-animate"
            data-delay="{{ forloop.index }}"
          >
            <article class="custom-best-sellers__card">
              {% if show_badge %}
                <span class="custom-best-sellers__badge">{{ section.settings.featured_badge }}</span>
              {% endif %}

              <a class="custom-best-sellers__media-link" href="{{ product.url }}">
                <div class="custom-best-sellers__media">
                  {% if product.featured_media %}
                    {% assign card_image_alt = product.featured_media.alt | default: product.title %}
                    {{
                      product.featured_media
                      | image_url: width: 1000
                      | image_tag:
                        class: 'custom-best-sellers__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 1000',
                        sizes: '(min-width: 990px) 280px, 45vw',
                        alt: card_image_alt
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'custom-best-sellers__image custom-best-sellers__image--placeholder' }}
                  {% endif %}
                </div>
              </a>

              {%- capture clean_title -%}
                {%- render 'sg-sanitize-line-breaks', text: card_title, mode: 'title' -%}
              {%- endcapture -%}
              {%- capture bs_title_link_html -%}
                <a href="{{ product.url }}">{{ clean_title | strip | escape }}</a>
              {%- endcapture -%}
              {% render 'sg-product-card-heading',
                title_html: bs_title_link_html,
                format: card_format,
                title_class: 'custom-best-sellers__title',
                format_class: 'custom-best-sellers__format'
              %}

              {% if card_description != blank %}
                <p class="custom-best-sellers__card-description">{{ card_description | escape }}</p>
              {% endif %}

              <div class="custom-best-sellers__price">
                {% render 'sg-product-card-price-row',
                  price: variant.price,
                  compare_at_price: variant.compare_at_price,
                  compare_class: 'custom-best-sellers__price-compare',
                  sale_class: 'custom-best-sellers__price-sale',
                  regular_class: 'custom-best-sellers__price-sale'
                %}
              </div>

              <a
                class="custom-best-sellers__btn"
                href="{{ product.url }}"
              >
                {{ 'spiritual_green.shop_now' | t }}
              </a>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="custom-best-sellers__empty">Nessun prodotto trovato nella collezione selezionata.</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-best-sellers {
    --bs-green: #97C48A;
    --bs-green-hover: #7FAF72;
    --bs-accent: #B0D4A6;
    --bs-white: #ffffff;
    --bs-text: #1a1a1a;
    --bs-text-secondary: #4a5568;
    --bs-border: #e8e8e4;
    --bs-font: 'DM Sans', system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: var(--bs-white);
    color: var(--bs-text);
    width: 100%;
    padding: 80px 40px;
    border-radius: 0;
    overflow: hidden;
  }

  .custom-best-sellers--alt {
    background: #ffffff;
  }

  .custom-best-sellers__inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .custom-best-sellers__header {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .custom-best-sellers__header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
  }

  .custom-best-sellers__heading {
    margin: 0;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.03em;
    color: var(--bs-text);
  }

  .custom-best-sellers__description {
    margin: 0;
    max-width: 640px;
    font-family: var(--bs-font);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    text-align: left;
    color: #666666;
  }

  .custom-best-sellers__shop-all {
    font-family: var(--bs-font);
    font-size: 14px;
    font-weight: 500;
    color: var(--bs-green) !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
    white-space: nowrap;
    transition: opacity 0.3s ease;
  }

  .custom-best-sellers__shop-all:hover {
    opacity: 0.7;
  }

  .custom-best-sellers__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  .custom-best-sellers__item {
    min-width: 0;
    display: flex;
  }

  .custom-best-sellers__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1 1 auto;
    width: 100%;
    height: 100%;
    padding: 20px;
    background: var(--bs-white);
    border: 1px solid var(--bs-border);
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition:
      background 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .custom-best-sellers__card:hover {
    background: var(--bs-white);
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgb(45 80 22 / 8%);
  }

  .custom-best-sellers__badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 1;
    padding: 4px 10px;
    border-radius: 50px;
    background: var(--color-section-alt-bg, #f5f5f0);
    color: var(--bs-accent);
    font-family: var(--bs-font);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .custom-best-sellers__media-link {
    display: block;
    width: 100%;
    text-decoration: none !important;
  }

  .custom-best-sellers__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    margin: 8px 0 12px;
    min-height: 160px;
    aspect-ratio: 1 / 1;
  }

  .custom-best-sellers__image {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 200px;
    object-fit: contain;
    transition: transform 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .custom-best-sellers__card:hover .custom-best-sellers__image {
    transform: scale(1.03);
  }

  .custom-best-sellers__image--placeholder {
    max-height: 160px;
    opacity: 0.5;
  }

  .custom-best-sellers__title {
    margin: 0;
    font-family: var(--bs-font);
    font-size: var(--sg-product-title-size, 1rem);
    font-weight: 400;
    line-height: 1.35;
    text-align: center;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: 2.7em;
    width: 100%;
  }

  .custom-best-sellers__format {
    margin: 0;
    font-family: var(--bs-font);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    color: #6b7280;
    width: 100%;
  }

  .custom-best-sellers__card-description {
    margin: 0 0 10px;
    font-family: var(--bs-font);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    color: #6b7280;
    display: -webkit-box !important;
    -webkit-box-orient: vertical !important;
    -webkit-line-clamp: 2 !important;
    line-clamp: 2 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    word-break: break-word;
    min-height: calc(1.45em * 2);
    max-height: calc(1.45em * 2);
    width: 100%;
  }

  .custom-best-sellers__title a {
    color: var(--bs-text) !important;
    text-decoration: none !important;
  }

  .custom-best-sellers__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 6px 8px;
    margin-bottom: 16px;
    font-family: var(--bs-font);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    color: var(--bs-text);
  }

  .custom-best-sellers__price-sale {
    color: var(--bs-green);
  }

  .custom-best-sellers__price-compare {
    color: #666666;
    font-weight: 400;
    text-decoration: line-through;
  }

  .custom-best-sellers__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 42px;
    min-height: 42px;
    margin-top: auto;
    padding: 0 16px;
    border: 1px solid var(--bs-green);
    border-radius: 6px;
    background: var(--bs-green);
    color: var(--bs-white) !important;
    font-family: var(--bs-font);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none !important;
    transition: background 0.2s ease, border-color 0.2s ease;
    box-sizing: border-box;
  }

  .custom-best-sellers__btn:hover {
    background: var(--bs-green-hover);
    border-color: var(--bs-green-hover);
  }

  .custom-best-sellers__empty {
    margin: 40px 0 0;
    text-align: center;
    font-family: var(--bs-font);
    color: var(--bs-text-secondary);
  }

  .custom-best-sellers .sg-animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }

  .custom-best-sellers .sg-animate.sg-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .custom-best-sellers .sg-animate[data-delay='1'] {
    transition-delay: 0.1s;
  }

  .custom-best-sellers .sg-animate[data-delay='2'] {
    transition-delay: 0.2s;
  }

  .custom-best-sellers .sg-animate[data-delay='3'] {
    transition-delay: 0.3s;
  }

  .custom-best-sellers .sg-animate[data-delay='4'] {
    transition-delay: 0.4s;
  }

  .custom-best-sellers .sg-animate[data-delay='5'] {
    transition-delay: 0.5s;
  }

  .custom-best-sellers .sg-animate[data-delay='6'] {
    transition-delay: 0.6s;
  }

  .custom-best-sellers .sg-animate[data-delay='7'] {
    transition-delay: 0.7s;
  }

  .custom-best-sellers .sg-animate[data-delay='8'] {
    transition-delay: 0.8s;
  }

  @media screen and (max-width: 1024px) {
    .custom-best-sellers__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 768px) {
    .custom-best-sellers {
      padding: 48px 0 48px 20px;
      border-radius: 0;
    }

    .custom-best-sellers__inner {
      padding-right: 0;
    }

    .custom-best-sellers__header {
      padding-right: 20px;
    }

    .custom-best-sellers__header-row {
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px;
    }

    .custom-best-sellers__shop-all {
      white-space: normal;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
    }

    .custom-best-sellers__grid {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 16px;
      margin-top: 28px;
      padding: 4px 20px 12px 0;
      scrollbar-width: none;
    }

    .custom-best-sellers__grid::-webkit-scrollbar {
      display: none;
    }

    .custom-best-sellers__item {
      flex: 0 0 min(78vw, 280px);
      scroll-snap-align: start;
    }

    .custom-best-sellers__card {
      padding: 16px;
    }

    .custom-best-sellers__title {
      font-size: 15px;
    }

    .custom-best-sellers__image {
      max-height: 160px;
    }

    .custom-best-sellers__btn {
      min-height: 44px;
      font-size: 13px;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-best-sellers {
      padding-left: 16px;
    }

    .custom-best-sellers__header {
      padding-right: 16px;
    }

    .custom-best-sellers__item {
      flex: 0 0 min(84vw, 280px);
    }
  }
{% endstylesheet %}

{% javascript %}
  function initBestSellersAnimate(root = document) {
    const items = root.querySelectorAll('.custom-best-sellers .sg-animate');
    if (!items.length) return;

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('sg-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('sg-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    items.forEach((item) => {
      if (!item.classList.contains('sg-visible')) {
        observer.observe(item);
      }
    });
  }

  initBestSellersAnimate();

  document.addEventListener('shopify:section:load', (event) => {
    if (event.target instanceof HTMLElement) {
      initBestSellersAnimate(event.target);
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "custom-best-sellers-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Number of products",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I Migliori Prodotti per il Tuo Benessere"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Prodotti naturali selezionati per supportare il tuo benessere quotidiano con ingredienti scientificamente studiati"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All Link",
      "default": "/collections/all"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "featured_badge",
      "label": "First product badge (optional)",
      "info": "Leave empty to hide badge"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "category": "Custom"
    }
  ]
}
{% endschema %}
