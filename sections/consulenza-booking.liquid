{% liquid
  assign booking_heading = section.settings.heading | default: 'Prenota la tua consulenza'
  assign booking_intro = section.settings.intro
  capture calendly_resolved
    render 'sg-consulenza-calendly-url', calendly_url: section.settings.calendly_url
  endcapture
  assign calendly_url = calendly_resolved | strip
  assign display_mode = section.settings.display_mode | default: 'inline'
  assign popup_label = section.settings.popup_button_label | default: 'Scegli data e ora'

  assign consultation_product = section.settings.consultation_product
  if consultation_product == blank and settings.sg_consulenza_product != blank
    assign consultation_product = settings.sg_consulenza_product
  endif
  assign purchase_form_id = 'sg-consulenza-purchase-' | append: section.id
%}

<section
  class="consulenza-booking"
  id="consulenza-booking"
  data-section-id="{{ section.id }}"
  {% if calendly_url != blank %}
    data-sg-consulenza-calendly-url="{{ calendly_url }}"
  {% endif %}
>
  <div class="consulenza-booking__inner">
    <header class="consulenza-booking__header">
      <h2 class="consulenza-booking__title">{{ booking_heading }}</h2>
      {% if booking_intro != blank %}
        <p class="consulenza-booking__intro">{{ booking_intro }}</p>
      {% endif %}
    </header>

    {% if consultation_product != blank %}
      {% render 'sg-consulenza-purchase',
        product: consultation_product,
        heading: section.settings.purchase_heading,
        button_label: section.settings.purchase_button_label,
        form_id: purchase_form_id
      %}
    {% endif %}

    {% if calendly_url == blank %}
      <div class="consulenza-booking__placeholder">
        <p>
          Inserisci l'URL Calendly di Alice nelle impostazioni della sezione
          <strong>Prenotazione Consulenza</strong> (es.
          <code>https://calendly.com/alice-username/consulenza</code>).
        </p>
        <button type="button" class="btn-prenota-ora btn-prenota-calendly" data-sg-consulenza-booking="scroll">
          {{ popup_label }}
        </button>
      </div>
    {% else %}
      {% if display_mode == 'popup' or display_mode == 'both' %}
        <div class="consulenza-booking__popup-wrap">
          <button
            type="button"
            class="btn-prenota-ora btn-prenota-calendly"
            data-sg-consulenza-booking="popup"
          >
            {{ popup_label }} →
          </button>
        </div>
      {% endif %}

      {% if display_mode == 'inline' or display_mode == 'both' %}
        <div
          class="calendly-inline-widget consulenza-booking__widget"
          data-url="{{ calendly_url }}"
          style="min-width: 320px; height: 700px;"
        ></div>
      {% endif %}
    {% endif %}
  </div>
</section>

{% if calendly_url != blank %}
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
  <script src="https://assets.calendly.com/assets/external/widget.js" type="text/javascript" async></script>
{% endif %}
<script src="{{ 'sg-consulenza-booking.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Consulenza Booking",
  "tag": "section",
  "class": "consulenza-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Prenota la tua consulenza"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Scegli il giorno e l'orario più comodo per te. Il calendario mostra la disponibilità aggiornata di Alice."
    },
    {
      "type": "url",
      "id": "calendly_url",
      "label": "Calendly event URL",
      "info": "Example: https://calendly.com/alice-username/consulenza-online"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Booking display",
      "default": "both",
      "options": [
        { "value": "inline", "label": "Inline widget" },
        { "value": "popup", "label": "Popup button only" },
        { "value": "both", "label": "Popup button + inline widget" }
      ]
    },
    {
      "type": "text",
      "id": "popup_button_label",
      "label": "Popup button label",
      "default": "Scegli data e ora"
    },
    {
      "type": "header",
      "content": "PayPal / checkout (optional)"
    },
    {
      "type": "product",
      "id": "consultation_product",
      "label": "Consultation product",
      "info": "Shopify product for the paid consultation. Shows Add to cart + PayPal express near booking."
    },
    {
      "type": "text",
      "id": "purchase_heading",
      "label": "Purchase heading",
      "default": "Acquista la consulenza"
    },
    {
      "type": "text",
      "id": "purchase_button_label",
      "label": "Add to cart label",
      "default": "Aggiungi al carrello"
    }
  ]
}
{% endschema %}
