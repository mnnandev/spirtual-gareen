{% comment %}
  Site-wide payment methods strip (footer group) — Apple Pay, Google Pay, PayPal, Visa, Mastercard.
{% endcomment %}

{%- liquid
  assign scroll_duration = section.settings.scroll_duration | default: 22
  assign enable_slider = section.settings.enable_slider
-%}

<section
  id="SgPaymentMethods-{{ section.id }}"
  class="sg-payment-methods{% if enable_slider %} sg-payment-methods--slider{% endif %}"
  style="
    --sg-pm-pad-top: {{ section.settings.padding_top }}px;
    --sg-pm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --sg-pm-marquee-duration: {{ scroll_duration }}s;
  "
>
  <div class="sg-payment-methods__inner">
    {% if section.settings.heading != blank %}
      <h2 class="sg-payment-methods__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="sg-payment-methods__viewport">
      <div
        class="sg-payment-methods__track{% if enable_slider %} sg-payment-methods__track--marquee{% endif %}"
        role="list"
        aria-label="{{ section.settings.heading | default: 'Metodi di pagamento' | escape }}"
      >
        {% if enable_slider %}
          {% for group_index in (1..2) %}
            <ul
              class="sg-payment-methods__group"
              role="presentation"
              {% if group_index == 2 %}
                aria-hidden="true"
              {% endif %}
            >
              {% for repeat in (1..4) %}
                {% render 'sg-payment-methods-icons', hide_labels: true %}
              {% endfor %}
            </ul>
          {% endfor %}
        {% else %}
          <ul class="sg-payment-methods__group" role="list">
            {% render 'sg-payment-methods-icons', hide_labels: false %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .sg-payment-methods {
    background: #ffffff;
    padding: var(--sg-pm-pad-top, 40px) 0 var(--sg-pm-pad-bottom, 48px);
    border-top: 1px solid #eff5ed;
    border-bottom: 1px solid #eff5ed;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .sg-payment-methods__inner {
    max-width: none;
    width: 100%;
    margin: 0 auto;
    padding: 0;
    text-align: center;
  }

  .sg-payment-methods__heading {
    margin: 0 0 32px;
    padding: 0 20px;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.45rem, 2.8vw, 1.85rem);
    font-weight: 500;
    color: #1a1a1a;
    letter-spacing: 0.01em;
  }

  .sg-payment-methods__viewport {
    overflow: hidden;
    width: 100%;
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .sg-payment-methods__track {
    display: flex;
    align-items: center;
    width: max-content;
  }

  .sg-payment-methods__track--marquee {
    animation: sg-pm-marquee var(--sg-pm-marquee-duration, 22s) linear infinite;
    will-change: transform;
  }

  .sg-payment-methods__track--marquee:hover {
    animation-play-state: paused;
  }

  @keyframes sg-pm-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .sg-payment-methods__group {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 36px;
    margin: 0;
    padding: 8px 28px;
    list-style: none;
  }

  .sg-payment-methods:not(.sg-payment-methods--slider) .sg-payment-methods__viewport {
    mask-image: none;
    -webkit-mask-image: none;
  }

  .sg-payment-methods:not(.sg-payment-methods--slider) .sg-payment-methods__track {
    width: 100%;
    justify-content: center;
  }

  .sg-payment-methods:not(.sg-payment-methods--slider) .sg-payment-methods__group {
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    padding: 8px 20px;
  }

  .sg-payment-methods__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 64px;
    padding: 8px 14px;
    background: #fff;
    border: 1px solid #e8eee6;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .sg-payment-methods__icon,
  .sg-payment-methods__item .icon,
  .sg-payment-methods__item svg {
    display: block;
    width: auto !important;
    height: 48px !important;
    max-width: 96px !important;
  }

  @media screen and (max-width: 749px) {
    .sg-payment-methods__heading {
      margin-bottom: 24px;
      font-size: clamp(1.25rem, 5vw, 1.45rem);
    }

    .sg-payment-methods__group {
      gap: 14px;
      padding: 6px 12px;
    }

    .sg-payment-methods__item {
      height: 48px;
      padding: 5px 10px;
      border-radius: 8px;
    }

    .sg-payment-methods__icon,
    .sg-payment-methods__item .icon,
    .sg-payment-methods__item svg {
      height: 32px !important;
      max-width: 68px !important;
    }
  }

  @media screen and (max-width: 480px) {
    .sg-payment-methods__viewport {
      mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    }

    .sg-payment-methods__group {
      gap: 12px;
      padding: 4px 10px;
    }

    .sg-payment-methods__item {
      height: 44px;
      padding: 4px 8px;
    }

    .sg-payment-methods__icon,
    .sg-payment-methods__item .icon,
    .sg-payment-methods__item svg {
      height: 28px !important;
      max-width: 60px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sg-payment-methods__track--marquee {
      animation: none;
    }

    .sg-payment-methods--slider .sg-payment-methods__viewport {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .sg-payment-methods--slider .sg-payment-methods__track {
      width: max-content;
    }

    .sg-payment-methods--slider .sg-payment-methods__group[aria-hidden='true'] {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SG Payment methods",
  "tag": "section",
  "class": "sg-payment-methods-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Accettiamo pagamenti con"
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable auto slider",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_duration",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Slider speed (loop duration)",
      "default": 22
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "SG Payment methods"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
