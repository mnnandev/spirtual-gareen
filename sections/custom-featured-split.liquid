{% liquid
  assign badge = section.settings.badge
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign btn_text = section.settings.btn_text
  assign btn_link = section.settings.btn_link

  assign main_image_url = blank
  assign main_image_alt = heading
  assign image_2_url = blank
  assign image_2_alt = heading
  assign image_3_url = blank
  assign image_3_alt = heading
  assign image_4_url = blank
  assign image_4_alt = heading

  if section.settings.main_image != blank
    assign main_image_url = section.settings.main_image | image_url: width: 1200
    assign main_image_alt = section.settings.main_image.alt | default: heading
  endif

  if section.settings.image_2 != blank
    assign image_2_url = section.settings.image_2 | image_url: width: 800
    assign image_2_alt = section.settings.image_2.alt | default: heading
  endif

  if section.settings.image_3 != blank
    assign image_3_url = section.settings.image_3 | image_url: width: 800
    assign image_3_alt = section.settings.image_3.alt | default: heading
  endif

  if section.settings.image_4 != blank
    assign image_4_url = section.settings.image_4 | image_url: width: 800
    assign image_4_alt = section.settings.image_4.alt | default: heading
  endif
%}

<section
  id="CustomFeaturedSplit-{{ section.id }}"
  class="custom-featured-split"
  data-section-id="{{ section.id }}"
>
  <div class="custom-featured-split__inner">
    <div class="custom-featured-split__content sg-animate">
      {% if badge != blank %}
        <span class="custom-featured-split__badge">{{ badge }}</span>
      {% endif %}

      {% if heading != blank %}
        <h2 class="custom-featured-split__heading">{{ heading }}</h2>
      {% endif %}

      {% if description != blank %}
        <div class="custom-featured-split__description rte">{{ description }}</div>
      {% endif %}

      {% if btn_text != blank %}
        <a
          class="custom-featured-split__btn"
          {% if btn_link != blank %}
            href="{{ btn_link }}"
          {% else %}
            role="link"
            aria-disabled="true"
          {% endif %}
        >
          {{ btn_text }}
        </a>
      {% endif %}
    </div>

    {% if main_image_url != blank or image_2_url != blank or image_3_url != blank or image_4_url != blank %}
    <div class="custom-featured-split__media sg-animate" data-delay="2">
      {% if main_image_url != blank %}
      <div class="custom-featured-split__main-wrap">
        <img
          class="custom-featured-split__main-image"
          src="{{ main_image_url }}"
          alt="{{ main_image_alt | escape }}"
          width="800"
          height="640"
          loading="lazy"
        >
      </div>
      {% endif %}

      <div class="custom-featured-split__thumbs">
        {% if image_2_url != blank %}
        <div class="custom-featured-split__thumb-wrap">
          <img
            class="custom-featured-split__thumb"
            src="{{ image_2_url }}"
            alt="{{ image_2_alt | escape }}"
            width="400"
            height="320"
            loading="lazy"
          >
        </div>
        {% endif %}
        {% if image_3_url != blank %}
        <div class="custom-featured-split__thumb-wrap">
          <img
            class="custom-featured-split__thumb"
            src="{{ image_3_url }}"
            alt="{{ image_3_alt | escape }}"
            width="400"
            height="320"
            loading="lazy"
          >
        </div>
        {% endif %}
        {% if image_4_url != blank %}
        <div class="custom-featured-split__thumb-wrap">
          <img
            class="custom-featured-split__thumb"
            src="{{ image_4_url }}"
            alt="{{ image_4_alt | escape }}"
            width="400"
            height="320"
            loading="lazy"
          >
        </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-featured-split {
    --cfs-green: #97C48A;
    --cfs-green-hover: #7FAF72;
    --cfs-cream: #f5f5f0;
    --cfs-badge-bg: #c8e6c9;
    --cfs-font: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background: var(--cfs-cream);
    margin: 0;
    padding: 0;
    border-radius: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .custom-featured-split__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 60px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 80px 60px;
    box-sizing: border-box;
  }

  .custom-featured-split__content {
    min-width: 0;
  }

  .custom-featured-split__badge {
    display: inline-block;
    width: fit-content;
    margin-bottom: 20px;
    padding: 5px 14px;
    border-radius: 50px;
    background: var(--cfs-badge-bg);
    color: var(--cfs-green);
    font-family: var(--cfs-font);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .custom-featured-split__heading {
    margin: 0 0 16px;
    font-family: var(--cfs-font);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--cfs-green);
  }

  .custom-featured-split__description {
    max-width: 420px;
    margin-bottom: 32px;
    font-family: var(--cfs-font);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--cfs-green);
    opacity: 0.75;
  }

  .custom-featured-split__description p {
    margin: 0;
  }

  .custom-featured-split__btn {
    position: relative;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    padding-right: 28px;
    border: none;
    border-radius: 50px;
    background: var(--cfs-green);
    color: #ffffff !important;
    font-family: var(--cfs-font);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none !important;
    transition:
      background 0.3s ease,
      padding-right 0.3s ease;
  }

  .custom-featured-split__btn::after {
    content: '→';
    position: absolute;
    top: 50%;
    right: -20px;
    transform: translateY(-50%);
    opacity: 0;
    font-size: 15px;
    line-height: 1;
    color: #ffffff;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .custom-featured-split__btn:hover {
    background: var(--cfs-green-hover);
    padding-right: 40px;
  }

  .custom-featured-split__btn:hover::after {
    right: 16px;
    opacity: 1;
  }

  .custom-featured-split__btn[aria-disabled='true'] {
    opacity: 0.55;
    pointer-events: none;
  }

  .custom-featured-split__media {
    min-width: 0;
  }

  .custom-featured-split__main-wrap {
    overflow: hidden;
    border-radius: 20px;
    margin-bottom: 12px;
    padding: 20px;
    background:rgb(255, 255, 255);
    box-sizing: border-box;
  }

  .custom-featured-split__main-image {
    display: block;
    width: 100%;
    height: 380px;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .custom-featured-split__main-wrap:hover .custom-featured-split__main-image {
    transform: scale(1.03);
  }

  .custom-featured-split__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .custom-featured-split__thumb-wrap {
    overflow: hidden;
    border-radius: 16px;
    padding: 12px;
    background:rgb(255, 255, 255);
    box-sizing: border-box;
  }

  .custom-featured-split__thumb {
    display: block;
    width: 100%;
    height: 180px;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .custom-featured-split__thumb-wrap:hover .custom-featured-split__thumb {
    transform: scale(1.03);
  }

  .custom-featured-split .sg-animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }

  .custom-featured-split .sg-animate.sg-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .custom-featured-split .sg-animate[data-delay='2'] {
    transition-delay: 0.2s;
  }

  @media screen and (max-width: 768px) {
    .custom-featured-split__inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px 20px;
    }

    .custom-featured-split__media {
      order: -1;
    }

    .custom-featured-split__description {
      max-width: none;
    }

    .custom-featured-split__main-wrap {
      padding: 16px;
    }

    .custom-featured-split__main-image {
      height: 220px;
    }

    .custom-featured-split__thumbs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .custom-featured-split__thumb-wrap:last-child {
      grid-column: 1 / -1;
    }

    .custom-featured-split__thumb-wrap:last-child .custom-featured-split__thumb {
      height: 160px;
    }

    .custom-featured-split__thumb {
      height: 150px;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initFeaturedSplitAnimate(root = document) {
    const items = root.querySelectorAll('.custom-featured-split .sg-animate');
    if (!items.length) return;

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('sg-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('sg-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    items.forEach((item) => {
      if (!item.classList.contains('sg-visible')) {
        observer.observe(item);
      }
    });
  }

  initFeaturedSplitAnimate();

  document.addEventListener('shopify:section:load', (event) => {
    if (event.target instanceof HTMLElement) {
      initFeaturedSplitAnimate(event.target);
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Featured Split",
  "tag": "section",
  "class": "custom-featured-split-section",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Visite Specialistiche"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "La cura naturale per la tua pelle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "I nostri prodotti naturali sono formulati per nutrire e rigenerare la tua pelle ogni giorno. Scopri la linea completa pensata per il tuo benessere quotidiano."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Scopri i Prodotti"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Small Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Small Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Small Image 3"
    }
  ],
  "presets": [
    {
      "name": "Featured Split",
      "category": "Custom"
    }
  ]
}
{% endschema %}
