{% liquid
  assign category_handles = 'sonno-mente-ed-energia,difese-protezione-vie-respiratorie,intestino-digestione-metabolismo,movimento-dolori-recupero,benessere-ormonale-intimo,bellezza-cura-della-persona,mondo-zen' | split: ','
  assign category_titles = 'Sonno, Mente ed Energia|Difese, Protezione e Vie Respiratorie|Intestino, Digestione e Metabolismo|Movimento, Dolori e Recupero|Benessere Ormonale e Intimo|Bellezza e Cura della Persona|Mondo Zen' | split: '|'
  assign category_subtitles = 'Dormire meglio, stress, ansia e relax, energia e stanchezza, concentrazione|Difese immunitarie, benessere naso e gola, allergie e respirazione, antiossidanti e protezione cellulare|Intestino e digestione, gonfiore e metabolismo, peso e fame nervosa, colesterolo e glicemia, depurazione|Dolori, infiammazione e articolazioni, muscoli e recupero, circolazione e gambe leggere, sport e prestazione|Benessere femminile, equilibrio ormonale, funzionalità delle vie urinarie|Pelle, capelli e unghie, profumi e trucco naturale|Armonia della casa, animali, oli essenziali e aromaterapia, rimedi fitoterapici, foulards Innbamboo' | split: '|'

  if section.settings.background_image != blank
    assign card_image_url = section.settings.background_image | image_url: width: 1600
  else
    assign card_image_url = blank
  endif
%}

<section
  id="CustomCategoriesGrid-{{ section.id }}"
  class="custom-categories-grid-section"
  data-section-id="{{ section.id }}"
>
  <div class="custom-categories-grid__container">
    <div class="categories-header sg-animate">
      <p class="categories-label">I NOSTRI PRODOTTI</p>
      <h2 class="categories-heading">Scopri le nostre categorie</h2>
      <p class="categories-desc">
        Prodotti naturali selezionati per ogni esigenza del tuo benessere quotidiano
      </p>
    </div>

    <div class="custom-categories-grid">
      {% for handle in category_handles %}
        {% assign card_title = category_titles[forloop.index0] %}
        {% assign card_subtitle = category_subtitles[forloop.index0] %}
        {% capture card_url %}{% render 'sg-collection-nav-url', handle: handle %}{% endcapture %}
        <a
          href="{{ card_url | strip }}"
          class="category-card custom-categories-grid__card sg-animate"
          data-delay="{{ forloop.index }}"
        >
          {% if card_image_url != blank %}
            <img
              class="category-card__image custom-categories-grid__image"
              src="{{ card_image_url }}"
              alt="{{ card_title | escape }}"
              width="800"
              height="640"
              loading="lazy"
            >
          {% else %}
            <span class="category-card__placeholder custom-categories-grid__placeholder" aria-hidden="true"></span>
          {% endif %}
          <span class="category-card__overlay custom-categories-grid__overlay" aria-hidden="true"></span>
          <div class="category-card__content custom-categories-grid__content">
            <h3 class="category-card__title custom-categories-grid__title">{{ card_title }}</h3>
            <p class="category-card__subtitle custom-categories-grid__subtitle">{{ card_subtitle }}</p>
            <span class="category-card__cta custom-categories-grid__cta">
              <span>Scopri</span>
              <span class="category-card__cta-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .custom-categories-grid-section {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    background: #f5f5f0;
    box-sizing: border-box;
  }

  .custom-categories-grid__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px;
    box-sizing: border-box;
  }

  .categories-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .categories-label {
    margin: 0 0 12px;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #1a1a1a;
    opacity: 0.5;
    line-height: 1.3;
  }

  .categories-heading {
    margin: 0 0 12px;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #1a1a1a;
  }

  .categories-desc {
    margin: 0 auto;
    max-width: 480px;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    color: #1a1a1a;
    opacity: 0.65;
  }

  .custom-categories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    box-sizing: border-box;
  }

  @media screen and (min-width: 769px) {
    .custom-categories-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1025px) {
    .custom-categories-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .custom-categories-grid__card:last-child:nth-child(3n + 1) {
      grid-column: 2;
    }
  }

  .category-card,
  .custom-categories-grid__card {
    position: relative;
    display: block;
    min-height: 380px;
    border-radius: 24px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none !important;
    color: inherit;
  }

  .category-card__placeholder,
  .custom-categories-grid__placeholder {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: #b8c9b0;
    transition: transform 0.6s ease;
  }

  .category-card__image,
  .custom-categories-grid__image {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .category-card:hover .category-card__image,
  .category-card:hover .custom-categories-grid__image,
  .custom-categories-grid__card:hover .custom-categories-grid__image,
  .category-card:hover .category-card__placeholder,
  .custom-categories-grid__card:hover .custom-categories-grid__placeholder {
    transform: scale(1.05);
  }

  .category-card__overlay,
  .custom-categories-grid__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(28, 58, 19, 0.75) 0%,
      rgba(28, 58, 19, 0.15) 60%,
      transparent 100%
    );
    pointer-events: none;
  }

  .category-card__content,
  .custom-categories-grid__content {
    position: absolute;
    bottom: 32px;
    left: 32px;
    z-index: 2;
    max-width: calc(100% - 64px);
  }

  .category-card__title,
  .custom-categories-grid__title {
    margin: 0 0 10px;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 1.6rem;
    font-weight: 350;
    line-height: 1.2;
    color: #ffffff;
  }

  .category-card__subtitle,
  .custom-categories-grid__subtitle {
    margin: 0 0 16px;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .category-card__cta,
  .custom-categories-grid__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50px;
    background: #97C48A;
    font-family: system-ui, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    color: #ffffff;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .category-card__cta-icon {
    display: flex;
    align-items: center;
    line-height: 0;
    transition: transform 0.3s ease;
  }

  .category-card:hover .category-card__cta,
  .custom-categories-grid__card:hover .custom-categories-grid__cta {
    background: #97C48A;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .category-card:hover .category-card__cta-icon,
  .custom-categories-grid__card:hover .category-card__cta-icon {
    transform: translateX(3px);
  }

  .custom-categories-grid-section .sg-animate {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.65s ease, transform 0.65s ease;
  }

  .custom-categories-grid-section .sg-animate.sg-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .custom-categories-grid-section .sg-animate[data-delay='1'] {
    transition-delay: 0.1s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='2'] {
    transition-delay: 0.2s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='3'] {
    transition-delay: 0.3s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='4'] {
    transition-delay: 0.4s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='5'] {
    transition-delay: 0.5s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='6'] {
    transition-delay: 0.6s;
  }

  .custom-categories-grid-section .sg-animate[data-delay='7'] {
    transition-delay: 0.7s;
  }

  @media screen and (max-width: 768px) {
    .custom-categories-grid__container {
      padding: 20px;
    }

    .categories-header {
      margin-bottom: 28px;
    }

    .custom-categories-grid {
      gap: 12px;
    }

    .category-card,
    .custom-categories-grid__card {
      min-height: 300px;
    }

    .category-card__content,
    .custom-categories-grid__content {
      bottom: 24px;
      left: 24px;
      max-width: calc(100% - 48px);
    }

    .category-card__title,
    .custom-categories-grid__title {
      font-size: 1.35rem;
    }

    .category-card__subtitle,
    .custom-categories-grid__subtitle {
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  function initCategoriesGridAnimate(root = document) {
    const items = root.querySelectorAll('.custom-categories-grid-section .sg-animate');
    if (!items.length) return;

    if (!('IntersectionObserver' in window)) {
      items.forEach((item) => item.classList.add('sg-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('sg-visible');
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );

    items.forEach((item) => {
      if (!item.classList.contains('sg-visible')) {
        observer.observe(item);
      }
    });
  }

  initCategoriesGridAnimate();

  document.addEventListener('shopify:section:load', (event) => {
    if (event.target instanceof HTMLElement) {
      initCategoriesGridAnimate(event.target);
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Categories Grid",
  "tag": "section",
  "class": "custom-categories-grid-shopify-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "I Nostri Prodotti"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Card background image",
      "info": "Optional placeholder used on all cards until individual images are set."
    }
  ],
  "presets": [
    {
      "name": "Categories Grid",
      "category": "Custom"
    }
  ]
}
{% endschema %}
