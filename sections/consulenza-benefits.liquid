<section
  class="consulenza-benefits"
  id="consulenza-benefits-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="consulenza-benefits__inner">
    {% if section.settings.heading != blank %}
      <h2 class="consulenza-benefits__title">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="consulenza-benefits__list" role="list">
      {% for block in section.blocks %}
        <li class="consulenza-benefits__item" {{ block.shopify_attributes }}>
          <span class="consulenza-benefits__marker" aria-hidden="true"></span>
          <div class="consulenza-benefits__content">
            {% if block.settings.title != blank %}
              <h3 class="consulenza-benefits__item-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="consulenza-benefits__item-desc">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Consulenza Benefits",
  "tag": "section",
  "class": "consulenza-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "I vantaggi della consulenza online"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Personalizzazione"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "ogni indicazione viene costruita sulle tue reali esigenze."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Consulenza Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "title": "Personalizzazione",
            "description": "ogni indicazione viene costruita sulle tue reali esigenze."
          }
        }
      ]
    }
  ]
}
{% endschema %}
