{% liquid
  assign footer_tagline = section.settings.tagline | default: "L'Erboristeria del Benessere"
  assign newsletter_heading = section.settings.newsletter_heading | default: 'Rimani Aggiornato'
  assign newsletter_text = section.settings.newsletter_text | default: 'Iscriviti per offerte esclusive e novità dal mondo del benessere naturale'
  assign copyright_text = section.settings.copyright_text | default: 'Spiritual Green · P.IVA IT02994440275'
  assign credit_text = section.settings.credit_text | default: 'Erboristeria del benessere naturale dal 1987'

  assign facebook_url = section.settings.facebook_url | default: 'https://www.facebook.com/SpiritualGreenErboristerie'
  assign instagram_url = section.settings.instagram_url | default: 'https://www.instagram.com/spiritualgreenerboristerie/'
  assign email_url = section.settings.email_url | default: 'mailto:info@spiritualgreen.it'
  assign phone_url = section.settings.phone_url | default: 'tel:+393939999136'
%}

<div
  id="CustomFooter-{{ section.id }}"
  class="custom-footer"
  data-section-id="{{ section.id }}"
>
  <div class="custom-footer__inner">
    <div class="custom-footer__top">
      <div class="custom-footer__col custom-footer__col--brand">
        <a href="{{ routes.root_url }}" class="custom-footer__logo-link">
          {% render 'sg-brand-logo',
            variant: 'header',
            tone: 'light',
            class: 'custom-footer__logo',
            height_desktop: 108,
            height_mobile: 76,
            max_width_desktop: 360,
            max_width_mobile: 280,
            loading: 'lazy'
          %}
        </a>
        {% if footer_tagline != blank %}
          <p class="custom-footer__tagline">{{ footer_tagline }}</p>
        {% endif %}

        <div class="custom-footer__social">
          {% if facebook_url != blank %}
            <a
              class="custom-footer__social-link"
              href="{{ facebook_url }}"
              aria-label="Facebook"
              {% if facebook_url != '#' %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          {% if instagram_url != blank %}
            <a
              class="custom-footer__social-link"
              href="{{ instagram_url }}"
              aria-label="Instagram"
              {% if instagram_url != '#' %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
              </svg>
            </a>
          {% endif %}
          {% if email_url != blank %}
            <a class="custom-footer__social-link" href="{{ email_url }}" aria-label="{{ 'spiritual_green.email_label' | t }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M4 6h16v12H4z" stroke-linejoin="round"/>
                <path d="m4 7 8 6 8-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
          {% if phone_url != blank %}
            <a class="custom-footer__social-link" href="{{ phone_url }}" aria-label="Telefono">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M6.5 4.5h3l1.5 4-2 1.5c1.2 2.4 3.1 4.3 5.5 5.5l1.5-2 4 1.5v3c0 .6-.4 1-1 1C10.4 18.5 5.5 13.6 5.5 7c0-.6.4-1 1-1z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="custom-footer__col">
        <p class="custom-footer__heading">{{ 'spiritual_green.footer_categories' | t }}</p>
        <ul class="custom-footer__links" role="list">
          {% liquid
            assign sg_footer_handles = 'sonno-mente-energia,difese-protezione-respiratorie,intestino-digestione-metabolismo,movimento-dolori-recupero,benessere-ormonale-intimo,bellezza-cura-persona,mondo-zen' | split: ','
            assign sg_footer_labels = 'Sonno, Mente ed Energia|Difese e Vie Respiratorie|Intestino e Digestione|Movimento e Recupero|Benessere Ormonale|Bellezza e Cura|Mondo Zen' | split: '|'
          %}
          {% for handle in sg_footer_handles %}
            {% assign footer_label = sg_footer_labels[forloop.index0] %}
            {% capture footer_url %}{% render 'sg-collection-nav-url', handle: handle %}{% endcapture %}
            <li><a href="{{ footer_url | strip }}">{{ footer_label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="custom-footer__col">
        <p class="custom-footer__heading">{{ 'spiritual_green.footer_shop' | t }}</p>
        <ul class="custom-footer__links" role="list">
          {% liquid
            assign sg_shop_nav_keys = 'shop|novita|piu-venduti|offerte|contatti' | split: '|'
            assign sg_shop_nav_translation_keys = 'spiritual_green.nav.shop|spiritual_green.nav.novita|spiritual_green.nav.piu_venduti|spiritual_green.nav.offerte|spiritual_green.nav.contatti' | split: '|'
          %}
          {% for nav_key in sg_shop_nav_keys %}
            {% assign nav_label = sg_shop_nav_translation_keys[forloop.index0] | t %}
            {% capture nav_href %}{% render 'sg-main-nav-url', key: nav_key %}{% endcapture %}
            <li><a href="{{ nav_href | strip }}">{{ nav_label }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div class="custom-footer__col">
        <p class="custom-footer__heading">{{ 'spiritual_green.footer_info' | t }}</p>
        <ul class="custom-footer__links" role="list">
          {% capture chi_siamo_url %}{% render 'sg-main-nav-url', key: 'chi-siamo' %}{% endcapture %}
          {% capture consulenza_url %}{% render 'sg-main-nav-url', key: 'consulenza' %}{% endcapture %}
          <li><a href="{{ chi_siamo_url | strip }}">{{ 'spiritual_green.nav.chi_siamo' | t }}</a></li>
          <li><a href="{{ consulenza_url | strip }}">{{ 'spiritual_green.nav.consulenza' | t }}</a></li>
          <li><a href="{% render 'sg-legal-nav-urls', type: 'privacy' %}">{{ 'spiritual_green.legal_privacy_policy' | t }}</a></li>
          <li><a href="{% render 'sg-legal-nav-urls', type: 'cookie' %}">{{ 'spiritual_green.legal_cookie_policy' | t }}</a></li>
          <li><a href="{% render 'sg-legal-nav-urls', type: 'terms' %}">{{ 'spiritual_green.legal_terms' | t }}</a></li>
          <li><a href="{% render 'sg-legal-nav-urls', type: 'refund' %}">{{ 'spiritual_green.legal_refund' | t }}</a></li>
          <li><a href="{% render 'sg-legal-nav-urls', type: 'faq' %}">{{ 'spiritual_green.faq' | t }}</a></li>
        </ul>
      </div>

      <div class="custom-footer__col custom-footer__col--newsletter">
        {% if newsletter_heading != blank %}
          <p class="custom-footer__heading">{{ newsletter_heading }}</p>
        {% endif %}
        {% if newsletter_text != blank %}
          <p class="custom-footer__newsletter-text">{{ newsletter_text }}</p>
        {% endif %}

        {% form 'customer', id: 'FooterNewsletter', class: 'custom-footer__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="custom-footer__newsletter-row">
            <label class="visually-hidden" for="FooterNewsletter-email">{{ 'blocks.email_signup.label' | t }}</label>
            <input
              id="FooterNewsletter-email"
              class="custom-footer__newsletter-input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ 'blocks.email_signup.placeholder' | t }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >
            <button class="custom-footer__newsletter-btn" type="submit" name="commit">
              {{ 'actions.sign_up' | t }}
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p class="custom-footer__form-message custom-footer__form-message--success">
              {{ 'blocks.email_signup.success' | t }}
            </p>
          {% endif %}
          {% if form.errors %}
            <p class="custom-footer__form-message custom-footer__form-message--error">
              {{ form.errors | default_errors }}
            </p>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="custom-footer__bottom">
      <p class="custom-footer__copy">© {{ 'now' | date: '%Y' }} {{ copyright_text }}</p>
      {% if credit_text != blank %}
        <p class="custom-footer__credit">{{ credit_text }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .custom-footer {
    --cf-green: #7FAF72;
    --cf-green-dark: #6A9A5E;
    --cf-font-body: 'DM Sans', system-ui, -apple-system, 'Helvetica Neue', Helvetica, Arial, sans-serif;
    width: 100%;
    background: var(--cf-green);
    color: #ffffff;
    padding: clamp(48px, 5.5vw, 64px) 0 clamp(28px, 3.5vw, 36px);
    box-sizing: border-box;
  }

  .custom-footer__inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 clamp(1.25rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  .custom-footer__top {
    display: grid;
    grid-template-columns: minmax(180px, 1.35fr) repeat(3, minmax(110px, 1fr)) minmax(200px, 1.2fr);
    gap: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(40px, 5vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .custom-footer__logo-link {
    display: inline-block;
    margin-bottom: 18px;
    line-height: 0;
  }

  .custom-footer__logo {
    display: block;
    width: auto;
    max-width: min(340px, 100%);
    object-fit: contain;
  }

  .custom-footer__tagline {
    margin: 0 0 24px;
    max-width: 280px;
    font-family: var(--cf-font-body);
    font-size: clamp(15px, 1.2vw, 16px);
    font-weight: 500;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }

  .custom-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .custom-footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%;
    color: #ffffff !important;
    text-decoration: none !important;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .custom-footer__social-link:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-2px);
  }

  .custom-footer__heading {
    margin: 0 0 20px;
    font-family: var(--cf-font-body);
    font-size: clamp(12px, 1vw, 13px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.3;
  }

  .custom-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom-footer__links li {
    margin: 0;
  }

  .custom-footer__links a {
    display: inline-block;
    font-family: var(--cf-font-body);
    font-size: clamp(15px, 1.1vw, 16px);
    font-weight: 500;
    line-height: 2.05;
    color: rgba(255, 255, 255, 0.92) !important;
    text-decoration: none !important;
    transition: color 0.2s ease;
  }

  .custom-footer__links a:hover {
    color: #ffffff !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
  }

  .custom-footer__newsletter-text {
    margin: 0 0 20px;
    font-family: var(--cf-font-body);
    font-size: clamp(14px, 1.1vw, 15px);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  .custom-footer__newsletter-form {
    margin: 0;
    width: 100%;
  }

  .custom-footer__newsletter-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    width: 100%;
  }

  .custom-footer__newsletter-input {
    width: 100%;
    min-height: 48px;
    padding: 12px 15px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-family: var(--cf-font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    box-sizing: border-box;
  }

  .custom-footer__newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .custom-footer__newsletter-input:focus {
    border-color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.14);
  }

  .custom-footer__newsletter-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 12px 15px;
    border: none;
    border-radius: 50px;
    background: #ffffff;
    color: var(--cf-green);
    font-family: var(--cf-font-body);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.25s ease, color 0.25s ease;
    box-sizing: border-box;
  }

  .custom-footer__newsletter-btn:hover {
    background: #F3F8F1;
    color: var(--cf-green-dark);
  }

  .custom-footer__form-message {
    margin: 12px 0 0;
    font-family: var(--cf-font-body);
    font-size: 13px;
    line-height: 1.4;
  }

  .custom-footer__form-message--success {
    color: rgba(255, 255, 255, 0.9);
  }

  .custom-footer__form-message--error {
    color: #ffd4d4;
  }

  .custom-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(28px, 3.5vw, 36px);
    flex-wrap: wrap;
  }

  .custom-footer__copy,
  .custom-footer__credit {
    margin: 0;
    font-family: var(--cf-font-body);
    font-size: clamp(13px, 1vw, 14px);
    font-weight: 500;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.58);
  }

  @media screen and (max-width: 1100px) {
    .custom-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px;
    }

    .custom-footer__col--brand,
    .custom-footer__col--newsletter {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 768px) {
    .custom-footer {
      padding: 28px 0 calc(18px + 56px + env(safe-area-inset-bottom, 0px));
    }

    .custom-footer__inner {
      padding: 0 16px;
    }

    .custom-footer__top {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-bottom: 20px;
    }

    .custom-footer__col,
    .custom-footer__col--brand,
    .custom-footer__col--newsletter {
      grid-column: 1 / -1;
      width: 100%;
    }

    .custom-footer__logo-link {
      margin-bottom: 10px;
    }

    .custom-footer__tagline {
      max-width: none;
      margin: 0 0 12px;
      font-size: 14px;
      line-height: 1.4;
    }

    .custom-footer__social-link {
      width: 36px;
      height: 36px;
    }

    .custom-footer__heading {
      margin: 0 0 8px;
      font-size: 12px;
    }

    .custom-footer__links a {
      display: block;
      font-size: 14px;
      font-weight: 400;
      line-height: 1.35;
      padding: 4px 0;
    }

    .custom-footer__newsletter-text {
      margin: 0 0 10px;
      font-size: 14px;
      line-height: 1.4;
    }

    .custom-footer__newsletter-input,
    .custom-footer__newsletter-btn {
      min-height: 44px;
    }

    .custom-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      margin-top: 16px;
    }

    .custom-footer__copy,
    .custom-footer__credit {
      font-size: 12px;
    }
  }

  @media screen and (max-width: 480px) {
    .custom-footer__inner {
      padding: 0 14px;
    }

    .custom-footer__top {
      gap: 18px;
      padding-bottom: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom footer",
  "tag": "section",
  "class": "custom-footer-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "L'Erboristeria del Benessere"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Rimani Aggiornato"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "Iscriviti per offerte esclusive e novità dal mondo del benessere naturale"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "text",
      "id": "email_url",
      "label": "Email (mailto:)",
      "default": "mailto:info@spiritualgreen.it"
    },
    {
      "type": "text",
      "id": "phone_url",
      "label": "Phone (tel:)",
      "default": "tel:+393939999136"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright line",
      "default": "Spiritual Green · P.IVA IT02994440275"
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Credit line",
      "default": "Erboristeria del benessere naturale dal 1987"
    }
  ],
  "presets": [
    {
      "name": "Custom footer",
      "category": "Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
